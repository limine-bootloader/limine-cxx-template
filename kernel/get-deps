#! /bin/sh

set -e

srcdir="$(dirname "$0")"
test -z "$srcdir" && srcdir=.

cd "$srcdir"

clone_repo_commit() {
    if test -d "$2/.git"; then
        git -C "$2" reset --hard
        git -C "$2" clean -fd
        if ! git -C "$2" -c advice.detachedHead=false checkout $3; then
            rm -rf "$2"
        fi
    else
        if test -d "$2"; then
            echo "error: '$2' is not a Git repository" 1>&2
            exit 1
        fi
    fi
    if ! test -d "$2"; then
        git clone $1 "$2"
        if ! git -C "$2" -c advice.detachedHead=false checkout $3; then
            rm -rf "$2"
            exit 1
        fi
    fi
}

rm -f .deps-obtained

clone_repo_commit \
    https://github.com/osdev0/freestanding-c-hdrs-gnu.git \
    freestanding-c-hdrs \
    cdd9b3cc11808d3259c082a77c33dfeb0f040adc

clone_repo_commit \
    https://github.com/osdev0/freestanding-cxx-hdrs-gnu.git \
    freestanding-cxx-hdrs \
    6fc33d66b123874631cf27bc9ab80a9ab3a43dd5

clone_repo_commit \
    https://github.com/osdev0/cc-runtime.git \
    cc-runtime \
    dae79833b57a01b9fd3e359ee31def69f5ae899b

clone_repo_commit \
    https://github.com/Limine-Bootloader/limine-protocol.git \
    limine-protocol \
    da65184e91f80fcb397270121b1e2515a11e01ee

touch .deps-obtained

printf "\nDependencies obtained successfully.\n"
